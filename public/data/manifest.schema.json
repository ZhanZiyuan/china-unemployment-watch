{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "observation_start": {
      "type": "string",
      "const": "2023-01-01"
    },
    "observation_end": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "passed",
        "partial_coverage"
      ]
    },
    "latest": {
      "type": "string",
      "const": "/data/latest.json"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "health": {
      "type": "string",
      "const": "/data/collection-status.json"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "algorithm_version",
    "generated_at",
    "observation_start",
    "observation_end",
    "quality_status",
    "latest",
    "sha256",
    "health"
  ],
  "additionalProperties": false
}
